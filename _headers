# En-têtes HTTP envoyés par Cloudflare Pages.
#
# Ce fichier n'est pas du HTML : c'est une consigne pour l'hébergeur.
# Cloudflare le lit au déploiement et ajoute ces lignes à chaque fichier
# du site qu'il envoie. (Les réponses de l'API, dans functions/, posent
# leurs propres en-têtes : voir json() dans functions/_outils.js.)
#
# /* veut dire « pour toutes les adresses du site ».

/*
  # HTTPS obligatoire pendant un an : le navigateur retient que ce site
  # ne se visite qu'en https et refuse même d'essayer en clair.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # LA RÈGLE DE SÉCURITÉ PRINCIPALE (Content-Security-Policy).
  #
  # Elle dit au navigateur d'où la page a le droit de charger quoi :
  # ici, uniquement depuis le site lui-même ('self'). Conséquence : même
  # si quelqu'un réussissait à glisser du code dans un pseudo ou un nom
  # de soirée, le navigateur refuserait de l'exécuter. Aucun script
  # écrit directement dans le HTML, aucun style dans un attribut
  # style="…" : tout passe par les fichiers de js/ et css/.
  #
  # frame-ancestors 'none' : personne ne peut afficher le site dans un
  # cadre chez lui (pour superposer de faux boutons, par exemple).
  #
  # Deux exceptions, pour Cloudflare Web Analytics (2 nov. 2026), le
  # compteur de visites sans cookie que Cloudflare ajoute lui-même aux
  # pages quand on l'active dans le tableau de bord : son script vient
  # de static.cloudflareinsights.com (script-src) et il envoie ses
  # mesures à cloudflareinsights.com (connect-src). Rien d'autre.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

  # Le navigateur croit le type annoncé d'un fichier, sans le deviner.
  X-Content-Type-Options: nosniff

  # Un lien vers un autre site ne lui transmet que le nom de domaine,
  # jamais l'adresse complète (qui contient le code du groupe).
  Referrer-Policy: strict-origin-when-cross-origin

  # Caméra, micro, position : le site n'en a aucun usage, porte fermée.
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Les polices ne changeront jamais : le navigateur les garde un an
# sans redemander.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# L'APPLI ANDROID (6 nov. 2026, voir CLAUDE.md, « L'appli Android »).
# Le type « application/vnd.android.package-archive » dit à Android que
# c'est une appli à installer ; « attachment » fait télécharger le
# fichier au lieu d'essayer de l'afficher. no-cache : le navigateur
# redemande à chaque fois s'il a changé, pour qu'une nouvelle version
# ne reste pas coincée derrière l'ancienne.
/allready.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="AllReady.apk"
  Cache-Control: no-cache

# La preuve que l'appli et le site vont ensemble : Android vient la
# lire ici, et l'appli s'ouvre alors en plein écran, sans barre
# d'adresse. Toujours en JSON.
/.well-known/assetlinks.json
  Content-Type: application/json
