# En-têtes HTTP envoyés par Cloudflare Pages.
#
# Ce fichier n'est pas du HTML : c'est une consigne pour l'hébergeur.
# Cloudflare le lit au déploiement et ajoute ces lignes à chaque fichier
# du site qu'il envoie. (Les réponses de l'API, dans functions/, posent
# leurs propres en-têtes : voir json() dans functions/_outils.js.)
#
# /* veut dire « pour toutes les adresses du site ».

/*
  # HTTPS obligatoire pendant un an : le navigateur retient que ce site
  # ne se visite qu'en https et refuse même d'essayer en clair.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # LA RÈGLE DE SÉCURITÉ PRINCIPALE (Content-Security-Policy).
  #
  # Elle dit au navigateur d'où la page a le droit de charger quoi :
  # ici, uniquement depuis le site lui-même ('self'). Conséquence : même
  # si quelqu'un réussissait à glisser du code dans un pseudo ou un nom
  # de soirée, le navigateur refuserait de l'exécuter. Aucun script
  # écrit directement dans le HTML, aucun style dans un attribut
  # style="…" : tout passe par les fichiers de js/ et css/.
  #
  # frame-ancestors 'none' : personne ne peut afficher le site dans un
  # cadre chez lui (pour superposer de faux boutons, par exemple).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

  # Le navigateur croit le type annoncé d'un fichier, sans le deviner.
  X-Content-Type-Options: nosniff

  # Un lien vers un autre site ne lui transmet que le nom de domaine,
  # jamais l'adresse complète (qui contient le code du groupe).
  Referrer-Policy: strict-origin-when-cross-origin

  # Caméra, micro, position : le site n'en a aucun usage, porte fermée.
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Les polices ne changeront jamais : le navigateur les garde un an
# sans redemander.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
